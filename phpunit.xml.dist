<?xml version="1.0" encoding="UTF-8"?>
<!-- https://docs.phpunit.de/en/13.4/configuration.html -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/cache/.phpunit"
         executionOrder="defects"
         resolveDependencies="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnPhpunitDeprecations="true">
  <php>
    <ini name="display_errors" value="1"/>
    <ini name="error_reporting" value="-1"/>
    <!-- Als server und env, damit auch ein in Docker gesetztes APP_ENV=prod überschrieben wird -->
    <server name="APP_ENV" value="test" force="true"/>
    <env name="APP_ENV" value="test" force="true"/>
    <env name="APP_DEBUG" value="1" force="true"/>
    <!-- Tests nie gegen die echte DB: im Docker-Container ist DATABASE_URL als echte Env-Variable gesetzt -->
    <env name="DATABASE_URL" value="sqlite:///%kernel.project_dir%/var/data.test.sqlite" force="true"/>
    <env name="MESSENGER_TRANSPORT_DSN" value="sync://" force="true"/>
    <env name="IMGPROXY_HOST" value="http://imgproxy.test" force="true"/>
    <!-- Keine echten Anfragen an OpenStreetMap aus Tests -->
    <env name="GEOCODING_ENABLED" value="0" force="true"/>
    <!-- Gesichtserkennung: die meisten Tests mocken AmazonRekognitionService, InsightFace-Tests setzen den Anbieter
         selbst; der echte face-service ist aus Tests nie erreichbar (Compose setzt sonst http://face-service:8000) -->
    <env name="FACE_RECOGNITION_PROVIDER" value="rekognition" force="true"/>
    <env name="FACE_SERVICE_URL" value="http://face-service.test" force="true"/>
    <env name="FACE_PREFILTER_DET_SIZE" value="0" force="true"/>
    <!-- Keine Anfragen an RabbitMQ aus Tests (Worker-Status) -->
    <env name="RABBITMQ_MANAGEMENT_URL" value="" force="true"/>
    <env name="IMGPROXY_PUBLIC_HOST" value="http://imgproxy.test" force="true"/>
    <server name="SHELL_VERBOSITY" value="-1"/>
    <!-- Tests räumen ihre Dateien weg: nie im echten Storage (im Container ist STORAGE_ROOT=storage gesetzt) -->
    <server name="STORAGE_ROOT" value="var/storage" force="true"/>
    <env name="STORAGE_ROOT" value="var/storage" force="true"/>
  </php>

  <testsuites>
    <testsuite name="unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="integration">
      <directory>tests/Integration</directory>
    </testsuite>
    <testsuite name="functional">
      <directory>tests/Functional</directory>
    </testsuite>
  </testsuites>

  <groups>
    <exclude>
      <!-- Echte ffmpeg/PySceneDetect-Pipeline, nur per "composer test:slow" -->
      <group>slow</group>
    </exclude>
  </groups>

  <source ignoreSuppressionOfDeprecations="true">
    <include>
      <directory suffix=".php">src</directory>
    </include>
  </source>

  <extensions>
    <bootstrap class="Symfony\Bridge\PhpUnit\SymfonyExtension">
      <parameter name="clock-mock-namespaces" value="App"/>
      <parameter name="dns-mock-namespaces" value="App"/>
    </bootstrap>
    <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    <bootstrap class="Zenstruck\Foundry\PHPUnit\FoundryExtension">
      <parameter name="enabled-auto-reset" value="true"/>
    </bootstrap>
  </extensions>
</phpunit>
