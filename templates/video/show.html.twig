{% extends 'base.html.twig' %}

{% block title %}Video Details: {{ video.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://vjs.zencdn.net/8.10.0/video-js.css" rel="stylesheet" />
    <style>
        .video-js {
            font-family: 'Inter', sans-serif;
        }
        .vjs-big-play-centered .vjs-big-play-button {
            top: 50%;
            left: 50%;
            margin-top: -0.75em;
            margin-left: -1.5em;
            background-color: rgba(25, 135, 84, 0.8);
            border-color: #198754;
            border-radius: 50%;
            width: 3em;
            height: 3em;
            line-height: 3em;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container pb-5" data-controller="video-player">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_video_index') }}">Videos</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ video.title }}</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h1 class="fw-bold h2 mb-1">{{ video.title }}</h1>
                            <div class="text-muted">
                                {{ component('MediumDateComponent', {medium: video}) }}
                                <div class="small mt-1">Importiert am {{ video.createdAt|date('d.m.Y H:i') }}</div>
                            </div>

                            {# Access Info Section #}
                            <div class="mt-2">
                                {% if video.isPublic %}
                                    <span class="badge bg-success px-3 py-1">
                                        <i class="fas fa-globe me-1"></i> Öffentlich zugänglich
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning text-dark px-3 py-1">
                                        <i class="fas fa-lock me-1"></i> Zugriff auf {{ video.allowedGroups|length }} Gruppe(n) eingeschränkt
                                    </span>
                                    <div class="small text-muted mt-1">
                                        Erlaubte Gruppen: {% for group in video.allowedGroups %}{{ group.name }}{% if not loop.last %}, {% endif %}{% endfor %}
                                    </div>
                                {% endif %}

                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_admin_video_groups', {id: video.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill px-3 ms-2">
                                        <i class="fas fa-shield-alt me-1"></i> Zugriff verwalten
                                    </a>
                                {% endif %}
                                {% if is_granted('VIDEO_EDIT', video) %}
                                    <div class="mt-2 d-flex gap-2">
                                        <form action="{{ path('video_update_scenes_public', {id: video.id}) }}" method="post" onsubmit="return confirm('Möchtest du wirklich alle Szenen auf öffentlich setzen?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('update-scenes-public' ~ video.id) }}">
                                            <input type="hidden" name="isPublic" value="1">
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                                <i class="fas fa-globe me-1"></i> Alle Szenen öffentlich
                                            </button>
                                        </form>
                                        <form action="{{ path('video_update_scenes_public', {id: video.id}) }}" method="post" onsubmit="return confirm('Möchtest du wirklich alle Szenen auf privat setzen?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('update-scenes-public' ~ video.id) }}">
                                            <input type="hidden" name="isPublic" value="0">
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="fas fa-lock me-1"></i> Alle Szenen privat
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2">
                            {{ video.status.label }}
                        </span>
                    </div>


                    <div class="mb-4">
                        <label class="small text-muted fw-bold text-uppercase mb-2">Analyse Fortschritt</label>
                        <div class="bg-light p-4 rounded-3 border">
                            {{ component('VideoProgressBar', { video: video }) }}
                        </div>
                    </div>

                    {% if video.jellyfinPath %}
                        <div class="alert alert-success border-0 shadow-sm p-4 mb-4">
                            <h6 class="fw-bold mb-3"><i class="fas fa-play-circle me-2"></i> Jellyfin Stream (Vorschau)</h6>
                            <div class="bg-black rounded-3 overflow-hidden shadow mb-3">
                                <video id="jellyfin-player" data-video-player-target="player" class="video-js vjs-big-play-centered vjs-16-9" controls preload="auto" data-setup='{"nativeControlsForTouch": false}' style="max-height: 70vh;">
                                    {% if video.jellyfinItemId %}
                                        <source src="{{ jellyfin_host }}/Videos/{{ video.jellyfinItemId }}/stream?static=true&api_key={{ jellyfin_api_key }}" type="video/mp4">
                                        <source src="{{ jellyfin_host }}/Videos/{{ video.jellyfinItemId }}/master.m3u8?api_key={{ jellyfin_api_key }}" type="application/x-mpegURL">
                                    {% else %}
                                        <source src="{{ jellyfin_host }}/Videos/ActiveStream?path={{ video.jellyfinPath|url_encode }}&api_key={{ jellyfin_api_key }}&static=true" type="video/mp4">
                                    {% endif %}
                                    <p class="vjs-no-js">
                                        To view this video please enable JavaScript, and consider upgrading to a
                                        web browser that <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
                                    </p>
                                </video>
                            </div>
                            <div id="player-error-message" data-video-player-target="errorMessage" class="alert alert-warning mt-2 d-none">
                                <i class="fas fa-exclamation-circle me-2"></i> Wiedergabe-Fehler: <span class="error-details"></span>
                            </div>
                            <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div class="small text-muted">
                                    <i class="fas fa-info-circle me-1"></i> Video wird direkt von Jellyfin gestreamt.
                                    {% if not video.jellyfinItemId %}
                                        <br><span class="text-warning"><i class="fas fa-sync fa-spin me-1"></i> Warte auf Item-ID von Jellyfin... (Seite eventuell neu laden)</span>
                                    {% endif %}
                                </div>
                                <div class="d-flex gap-2">
                                    {% if video.jellyfinItemId %}
                                        <a href="{{ jellyfin_host }}/web/index.html#!/details?id={{ video.jellyfinItemId }}" target="_blank" class="btn btn-sm btn-outline-success">
                                            <i class="fas fa-external-link-alt me-1"></i> In Jellyfin öffnen
                                        </a>
                                    {% endif %}
                                </div>
                            </div>

                            {% if video.chapters|length > 0 %}
                                <div class="mt-4">
                                    <h6 class="fw-bold mb-3 small text-uppercase text-muted"><i class="fas fa-bookmark me-2"></i> Kapitel / Szenen</h6>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for chapter in video.chapters %}
                                            <button class="btn btn-sm btn-light border" data-action="video-player#jumpTo" data-video-player-time-param="{{ chapter.startSeconds }}">
                                                <i class="fas fa-step-forward me-1"></i> {{ chapter.title ?: 'Szene ' ~ loop.index }}
                                            </button>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                        </div>
                    {% endif %}

                    {% if video.errorMessage or video.status.value == 'error' %}
                        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-start p-4">
                            <i class="fas fa-exclamation-triangle mt-1 me-3 fa-lg"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">Analyse fehlgeschlagen</h5>
                                <p class="mb-0 font-monospace small">{{ video.errorMessage ?? 'Details stehen beim fehlgeschlagenen Schritt in der Pipeline-Übersicht.' }}</p>
                                <hr>
                                {% if is_granted('VIDEO_EDIT', video) %}
                                <div class="d-flex gap-2 mt-3">
                                    <form action="{{ path('video_reprocess', {id: video.id}) }}" method="post" class=""
                                      onsubmit="return confirm('Analyse neu starten? Szenen und erkannte Gesichter dieses Videos werden dabei neu erzeugt.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('reprocess' ~ video.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-rotate-right me-1"></i>Analyse neu starten</button>
                                </form>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

                            {{ component('VideoTranscriptComponent', { video: video, id: 'transcript' }) }}

                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-transparent border-bottom p-4">
                                    <h5 class="fw-bold mb-0">Pipeline Schritte</h5>
                                </div>
                                <div class="card-body p-0">
                                    {{ component('VideoPipelineComponent', { video: video }) }}
                                </div>
                                {% if video.processingSteps|length > 0 %}
                                    <div class="card-footer bg-transparent p-4">
                                        <h6 class="fw-bold mb-3 small text-uppercase text-muted"><i class="fas fa-tasks me-2"></i> Details</h6>
                                        <div class="list-group">
                                            {% for step in video.processingSteps %}
                                                <a href="{{ path('app_video_processing_step_show', {'id': step.id}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                    {{ step.step.value }}
                                                    <span class="badge {{ step.finishedAt ? 'bg-success' : (step.errorMessage ? 'bg-danger' : 'bg-warning') }} rounded-pill">
                                                        {{ step.finishedAt ? 'Fertig' : (step.errorMessage ? 'Fehler' : 'In Bearbeitung') }}
                                                    </span>
                                                </a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            </div>
        </div>

        <div class="col-lg-4">
            {{ component('MediumEventsComponent', {medium: video, class: 'card border-0 shadow-sm mb-4'}) }}

            {% if video.hasLocation %}
                <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                    {{ include('map/_embed.html.twig', {url: path('app_map_points', {medium: video.id}), height: '220px'}) }}
                </div>
            {% endif %}

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-transparent border-bottom p-4">
                    <h5 class="fw-bold mb-0">Aktionen</h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <a href="{{ path('video_timeline', {id: video.id}) }}" class="btn btn-outline-primary rounded-pill mb-2">
                            <i class="fas fa-chart-line me-2"></i> Timeline anzeigen
                        </a>
                        {% if is_granted('VIDEO_EDIT', video) %}
                        <hr>
                        <h6 class="small text-muted fw-bold text-uppercase mb-3">Thumbnail</h6>
                        <form action="{{ path('video_extract_thumbnail', {id: video.id}) }}" method="post" id="extract-thumbnail-form" data-action="submit->video-player#prepareThumbnail">
                            <input type="hidden" name="time" id="thumbnail-time-input" data-video-player-target="thumbnailInput">
                            <div class="position-relative mb-3 bg-light rounded overflow-hidden shadow-sm" style="aspect-ratio: 16/9;">
                                {% if video.thumbnailUrl %}
                                    <img src="{{ imgproxy_url(video.thumbnailFile, 320, 180) }}" alt="Current Thumbnail" class="w-100 h-100 object-fit-cover">
                                {% else %}
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                        <i class="fas fa-image fa-2x"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <p class="small text-muted mb-2">Setze das aktuelle Frame des Videos als Thumbnail.</p>
                            <button type="submit" class="btn btn-outline-secondary w-100 rounded-pill mb-2">
                                <i class="fas fa-camera me-2"></i> Als Thumbnail setzen
                            </button>
                        </form>
                        <hr>
                        <h6 class="small text-muted fw-bold text-uppercase mb-3">Jellyfin Integration</h6>
                        {% if video.jellyfinItemId %}
                            <p class="small text-muted"><i class="fas fa-check-circle text-success me-1"></i> Bereits in Jellyfin vorhanden.</p>
                        {% elseif video.status.value == 'completed' %}
                            <form action="{{ path('app_jellyfin_export', {id: video.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('jellyfin-export' ~ video.id) }}">
                                <p class="small text-muted mb-2">Exportiere dieses Video in deine Jellyfin-Mediathek.</p>
                                <button type="submit" class="btn btn-primary w-100 rounded-pill" {{ not video.sourceFile ? 'disabled' }}>
                                    <i class="fas fa-share-square me-2"></i> Zu Jellyfin exportieren
                                </button>
                                {% if not video.sourceFile %}
                                    <div class="alert alert-warning small mt-2 py-1 px-2 border-0">
                                        <i class="fas fa-exclamation-circle me-1"></i> Keine Quelldatei vorhanden. Export nicht möglich.
                                    </div>
                                {% endif %}
                            </form>
                        {% else %}
                            <p class="small text-muted">Export verfügbar, sobald die Analyse abgeschlossen ist.</p>
                        {% endif %}
                        <hr>
                        {% if video.status.processing %}
                            <button type="button" class="btn btn-sm btn-light border text-muted d-flex justify-content-between align-items-center w-100 mb-2" disabled
                                    title="Erst möglich, wenn die laufende Verarbeitung beendet ist">
                                <span><i class="fas fa-undo me-2"></i> Analyse neu starten</span>
                                <i class="fas fa-hourglass-half small opacity-50"></i>
                            </button>
                        {% else %}
                            <form action="{{ path('video_reprocess', {id: video.id}) }}" method="post" class="mb-2"
                                      onsubmit="return confirm('Analyse neu starten? Szenen und erkannte Gesichter dieses Videos werden dabei neu erzeugt.')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('reprocess' ~ video.id) }}">
                                    <button type="submit" class="btn btn-sm btn-light border text-danger d-flex justify-content-between align-items-center w-100">
                                        <span><i class="fas fa-undo me-2"></i> Analyse neu starten</span>
                                        <i class="fas fa-chevron-right small opacity-50"></i>
                                    </button>
                                </form>
                        {% endif %}
                        <a href="{{ path('app_video_trigger', {id: video.id, step: 'delete'}) }}"
                           class="btn btn-sm btn-outline-danger d-flex justify-content-between align-items-center"
                           onclick="return confirm('Möchtest du wirklich die lokale Videodatei und alle temporären Frames löschen? Die Analyseergebnisse bleiben erhalten.')">
                            <span><i class="fas fa-trash-alt me-2"></i> Lokale Dateien löschen</span>
                            <i class="fas fa-chevron-right small opacity-50"></i>
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>

            {% if video.sourceFile or video.convertedFile %}
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-transparent border-bottom p-4">
                        <h5 class="fw-bold mb-0">Datei-Info</h5>
                    </div>
                    <div class="card-body p-4">
                        {% if video.convertedFile %}
                            <div class="mb-3">
                                <label class="small text-muted fw-bold text-uppercase mb-1">Aktuelle Datei (Konvertiert)</label>
                                <div class="small text-truncate" title="{{ video.convertedFile.relativePath }}">{{ video.convertedFile.relativePath|split('/')|last }}</div>
                                <code class="d-block bg-light p-2 rounded small text-break mt-1" style="font-size: 0.7rem;">{{ video.convertedFile.relativePath }}</code>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label class="small text-muted fw-bold text-uppercase mb-1">Status</label>
                            <div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                    <i class="fas fa-check-circle me-1"></i> File-Entity vorhanden
                                </span>
                            </div>
                        </div>

                        {% if video.sourceFile %}
                            <div class="mb-3">
                                <label class="small text-muted fw-bold text-uppercase mb-1">Original Datei</label>
                                <div class="small text-truncate" title="{{ video.sourceFile.relativePath }}">{{ video.sourceFile.relativePath|split('/')|last }}</div>
                            </div>
                        {% endif %}

                        <div class="mb-3">
                            <label class="small text-muted fw-bold text-uppercase mb-1">Zweck (Purpose)</label>
                            <div class="small font-monospace">{{ (video.convertedFile ?? video.sourceFile).purpose.value }}</div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-transparent border-bottom p-4">
                        <h5 class="fw-bold mb-0">Datei-Info</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-warning mb-0 py-2 px-3 small border-0">
                            <i class="fas fa-exclamation-triangle me-1"></i> Keine File-Entity zugeordnet.
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Video.js wird per CDN geladen und global als window.videojs bereitgestellt.
       Die Player-Logik ist in den Stimulus-Controller
       assets/controllers/video_player_controller.js ausgelagert. #}
    <script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>
{% endblock %}
