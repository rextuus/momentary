{% extends 'base.html.twig' %}

{% block title %}{{ chapter.title }}{% endblock %}

{% block body %}
    <div class="container-fluid">
        <h1>{{ chapter.title }}</h1>
        <p class="text-muted">{{ chapter.startSeconds|number_format(0) }}s - {{ chapter.endSeconds|number_format(0) }}s</p>
        
        <div class="mb-3 d-flex gap-2">
            <form action="{{ path('chapter_update_scenes_public', {id: chapter.id}) }}" method="post" onsubmit="return confirm('Möchtest du wirklich alle Szenen dieses Kapitels auf öffentlich setzen?');">
                <input type="hidden" name="_token" value="{{ csrf_token('update-chapter-scenes-public' ~ chapter.id) }}">
                <input type="hidden" name="isPublic" value="1">
                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">
                    <i class="fas fa-globe me-1"></i> Alle Szenen öffentlich
                </button>
            </form>
            <form action="{{ path('chapter_update_scenes_public', {id: chapter.id}) }}" method="post" onsubmit="return confirm('Möchtest du wirklich alle Szenen dieses Kapitels auf privat setzen?');">
                <input type="hidden" name="_token" value="{{ csrf_token('update-chapter-scenes-public' ~ chapter.id) }}">
                <input type="hidden" name="isPublic" value="0">
                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                    <i class="fas fa-lock me-1"></i> Alle Szenen privat
                </button>
            </form>
        </div>

        <div class="scenes-list">
            {% for scene in scenes %}
                <div class="mb-3">
                    {{ component('SceneSectionComponent', {
                        scene: scene,
                        sceneNumber: loop.index
                    }) }}
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
