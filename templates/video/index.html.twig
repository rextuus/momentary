{% extends 'base.html.twig' %}

{% block title %}Videos - Momentary{% endblock %}

{% block body %}
    <div class="container pb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-0">Videos</h1>
                <p class="text-muted">Verwalte deine Video-Pipeline</p>
            </div>
            <a href="{{ path('video_new') }}" class="btn btn-primary shadow-sm rounded-pill px-4">
                <i class="fas fa-plus me-2"></i>Neues Video
            </a>
        </div>

        <div class="row g-4">
            {% for video in videos %}
                <div class="col-12">
                    <div class="card overflow-hidden">
                        <div class="row g-0">
                            {% set statusInfo = {
                                'pending': {'color': 'secondary', 'icon': 'clock'},
                                'downloading': {'color': 'info', 'icon': 'download'},
                                'scene_detection': {'color': 'warning', 'icon': 'cut'},
                                'splitting': {'color': 'primary', 'icon': 'film'},
                                'analyzing_faces': {'color': 'dark', 'icon': 'user-search'},
                                'optimizing': {'color': 'info', 'icon': 'magic'},
                                'completed': {'color': 'success', 'icon': 'check-circle'},
                                'error': {'color': 'danger', 'icon': 'exclamation-triangle'}
                            }[video.status.value] ?? {'color': 'secondary', 'icon': 'question'} %}

                            <div class="col-md-auto position-relative bg-light d-flex align-items-center justify-content-center overflow-hidden" style="width: 200px; min-height: 120px;">
                                {% if video.thumbnailUrl %}
                                    {% set is_allowed = is_granted('VIDEO_VIEW', video) %}
                                    {% set blur = (not is_allowed and (app.user is null or (app.user.settings and app.user.settings.blurForbiddenContent))) ? 5 : 0 %}
                                    <img src="{{ imgproxy_url(video.thumbnailUrl, 200, 120, 'fill', blur) }}" alt="{{ video.title }}" class="w-100 h-100 object-fit-cover position-absolute top-0 start-0">
                                {% endif %}
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-{{ statusInfo.color }} bg-opacity-25" style="z-index: 1;">
                                    <i class="fas fa-{{ statusInfo.icon }} text-white fa-lg shadow-sm"></i>
                                </div>
                            </div>

                            <div class="col">
                                <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between">
                                    <div class="mb-3 mb-md-0">
                                        <div class="d-flex align-items-center mb-1">
                                            <h5 class="card-title mb-0 me-3 fw-bold">
                                                <a href="{{ path('app_video_show', {id: video.id}) }}" class="text-decoration-none text-dark hover-primary">
                                                    {{ video.title }}
                                                </a>
                                            </h5>
                                            <span class="badge rounded-pill bg-{{ statusInfo.color }} bg-opacity-10 text-{{ statusInfo.color }} border border-{{ statusInfo.color }}">
                                                {{ video.status.value|upper }}
                                            </span>
                                        </div>
                                        {% if video.localPath %}
                                            <div class="d-flex align-items-center text-truncate mb-2" style="max-width: 400px;">
                                                <i class="fas fa-file-video small me-2 text-muted"></i>
                                                <code class="small text-muted" style="font-size: 0.75rem;">{{ video.localPath|split('/')|last }}</code>
                                            </div>
                                        {% endif %}

                                        <div class="mt-2 mb-2">
                                            {% if video.isPublic %}
                                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success" title="Öffentlich">
                                                    <i class="fas fa-globe me-1"></i> Öffentlich
                                                </span>
                                            {% else %}
                                                <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning" title="Eingeschränkter Zugriff">
                                                    <i class="fas fa-lock me-1"></i> {{ video.allowedGroups|length }} Gruppe(n)
                                                </span>
                                            {% endif %}

                                            {% if is_granted('ROLE_ADMIN') %}
                                                <a href="{{ path('app_admin_video_groups', {id: video.id}) }}" class="btn btn-sm btn-outline-secondary rounded-pill px-2 ms-2" title="Zugriff verwalten">
                                                    <i class="fas fa-shield-alt"></i>
                                                </a>
                                            {% endif %}
                                        </div>

                                        {% if video.status.value != 'completed' and video.status.value != 'pending' and video.status.value != 'error' %}
                                            <div class="mt-3" style="max-width: 400px;">
                                                {{ component('VideoProgressBar', { video: video }) }}
                                            </div>
                                        {% endif %}

                                        {% if video.status.value == 'error' and video.errorMessage %}
                                            <div class="alert alert-danger py-2 px-3 small mb-2 border-0 shadow-sm" style="font-size: 0.8rem;">
                                                <div class="fw-bold mb-1"><i class="fas fa-exclamation-circle me-1"></i> Fehler-Details:</div>
                                                <div class="font-monospace text-break">{{ video.errorMessage }}</div>
                                            </div>
                                        {% endif %}

                                    </div>

                                    <div class="d-flex flex-wrap gap-2 align-items-center">
                                        <a href="{{ path('app_video_show', {id: video.id}) }}" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                                            <i class="fas fa-eye me-1"></i> Details
                                        </a>

                                        <a href="{{ path('video_timeline', {id: video.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fas fa-chart-line me-1"></i> Timeline
                                        </a>

                                        <form method="post" action="{{ path('video_delete', {id: video.id}) }}" onsubmit="return confirm('Soll dieses Video wirklich gelöscht werden?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ video.id) }}">
                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fas fa-trash-alt me-1"></i> Löschen
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12 text-center py-5">
                    <div class="text-muted mb-3">
                        <i class="fas fa-video-slash fa-3x"></i>
                    </div>
                    <h3>Noch keine Videos in der Pipeline</h3>
                    <p>Füge dein erstes Video hinzu, um die Magie zu starten.</p>
                    <a href="{{ path('video_new') }}" class="btn btn-primary mt-2">Jetzt starten</a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}