{% extends 'base.html.twig' %}

{% block title %}Processing Step: {{ step.step.value }}{% endblock %}

{% block body %}
<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_video_index') }}">Videos</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_video_show', {'id': step.video.id}) }}">{{ step.video.title }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Processing Step</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 fw-bold mb-4">Processing Step: {{ step.step.value }}</h1>
            
            <div class="row mb-4">
                <div class="col-md-6">
                    <p class="text-muted mb-1">Video</p>
                    <a href="{{ path('app_video_show', {'id': step.video.id}) }}" class="text-decoration-none h5">{{ step.video.title }}</a>
                </div>
            </div>
            
            <div class="list-group list-group-flush mb-4">
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Erstellt am</span>
                        <span class="fw-medium">{{ step.createdAt|date('d.m.Y H:i:s') }}</span>
                    </div>
                </div>
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Gestartet am</span>
                        <span class="fw-medium">{{ step.startedAt ? step.startedAt|date('d.m.Y H:i:s') : 'N/A' }}</span>
                    </div>
                </div>
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Verarbeitet am</span>
                        <span class="fw-medium">{{ step.processedAt ? step.processedAt|date('d.m.Y H:i:s') : 'N/A' }}</span>
                    </div>
                </div>
                <div class="list-group-item px-0">
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Abgeschlossen am</span>
                        <span class="fw-medium">{{ step.finishedAt ? step.finishedAt|date('d.m.Y H:i:s') : 'N/A' }}</span>
                    </div>
                </div>
            </div>

            {% if step.errorMessage %}
                <div class="alert alert-danger border-0 shadow-sm p-4">
                    <h6 class="fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Error:</h6>
                    <p class="mb-0">{{ step.errorMessage }}</p>
                </div>
            {% endif %}

            <div class="mt-4">
                <a href="{{ path('app_video_show', {'id': step.video.id}) }}" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="fas fa-arrow-left me-1"></i> Zurück zum Video
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
