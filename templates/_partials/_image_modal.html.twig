{# templates/_partials/_image_modal.html.twig #}
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true" data-controller="image-modal">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0 pb-5">
                <div class="position-relative d-inline-block">
                    <img src="" id="modalImage" data-image-modal-target="image" class="img-fluid rounded" alt="Detailansicht">

                    <div id="modalBox" data-image-modal-target="box" class="position-absolute border border-primary border-4 shadow"
                         style="display: none; pointer-events: none; z-index: 100;"></div>
                </div>
                <div id="modalCaption" data-image-modal-target="caption" class="text-white mt-3 opacity-75 small"></div>
            </div>
        </div>
    </div>
</div>