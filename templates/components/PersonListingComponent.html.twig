<div {{ attributes }}>
    {% set items = this.items %}
    {% set total = this.total %}

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-12 col-md">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="search"
                               data-model="debounce(300)|search"
                               value="{{ search }}"
                               class="form-control border-start-0 ps-0"
                               placeholder="Name, Beziehung oder Notiz suchen …"
                               aria-label="Personen suchen">
                    </div>
                </div>
                <div class="col-12 col-md-auto">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fas fa-sort-amount-down text-muted"></i></span>
                        <select data-model="sort" class="form-select" aria-label="Sortierung">
                            {% for value, label in this.sortOptions %}
                                <option value="{{ value }}" {{ sort == value ? 'selected' }}>{{ label }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2" role="group" aria-label="Status-Filter">
                {% for option in this.statusOptions %}
                    {% set color = option.status.color %}
                    <button type="button"
                            class="btn btn-sm rounded-pill {{ option.active ? 'btn-' ~ color : 'btn-outline-' ~ color }}"
                            aria-pressed="{{ option.active ? 'true' : 'false' }}"
                            data-action="live#action"
                            data-live-action-param="toggleStatus"
                            data-live-status-param="{{ option.status.value }}">
                        {% if option.active %}<i class="fas fa-check me-1"></i>{% endif %}
                        {{ option.status.label }}
                        <span class="badge rounded-pill {{ option.active ? 'text-bg-light' : 'text-bg-' ~ color }} ms-1">{{ option.count }}</span>
                    </button>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3 small text-muted">
        <span>
            {{ total }} {{ total == 1 ? 'Person' : 'Personen' }}
            {% if search %} für „{{ search }}“{% endif %}
        </span>
        <span data-loading class="d-none"><i class="fas fa-spinner fa-spin me-1"></i> Lädt …</span>
    </div>

    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xxl-6 g-3" data-loading="addClass(opacity-50)">
        {% for item in items %}
            {% set person = item.person %}
            {% set face = item.previewFace %}
            <div class="col">
                <a href="{{ path('person_detail', { id: person.id }) }}" class="person-tile card h-100 border-0 shadow-sm text-decoration-none text-body overflow-hidden">
                    <div class="position-relative">
                    <div class="ratio ratio-1x1 bg-body-secondary">
                        {% if face and face.faceImage %}
                            <img src="{{ face_crop_url(face.faceImage.relativePath, face.boundingBox, 300) }}"
                                 alt="{{ person.displayName }}"
                                 loading="lazy"
                                 class="object-fit-cover w-100 h-100">
                        {% else %}
                            <div class="d-flex align-items-center justify-content-center text-muted">
                                <i class="fas fa-user fa-3x opacity-50"></i>
                            </div>
                        {% endif %}
                    </div>
                    <span class="position-absolute top-0 start-0 m-2 badge rounded-pill text-bg-{{ person.status.color }} shadow-sm">
                        {{ person.status.label }}
                    </span>
                    </div>
                    <div class="card-body p-2 px-3">
                        <div class="fw-semibold text-truncate {{ person.hasPlaceholderName ? 'text-muted fst-italic' }}" title="{{ person.displayName }}">
                            {{ person.displayName }}
                        </div>
                        {% if person.relation or person.fullName %}
                            <div class="small text-muted text-truncate">{{ person.relation ?: person.fullName }}</div>
                        {% endif %}
                        <div class="d-flex gap-3 small text-muted mt-1">
                            <span title="Sichtungen"><i class="fas fa-user-circle me-1"></i>{{ item.faceCount }}</span>
                            <span title="Videos"><i class="fas fa-video me-1"></i>{{ item.videoCount }}</span>
                            {% if person.age %}<span title="Alter"><i class="fas fa-birthday-cake me-1"></i>{{ person.age }}</span>{% endif %}
                        </div>
                    </div>
                </a>
            </div>
        {% else %}
            <div class="col-12 w-100">
                <div class="text-center text-muted py-5">
                    <i class="fas fa-users-slash fa-3x mb-3 opacity-50"></i>
                    <p class="mb-0">
                        {% if statuses is empty %}Kein Status ausgewählt.{% else %}Keine Personen gefunden.{% endif %}
                    </p>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if items|length < total %}
        <div class="text-center mt-4">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-action="live#action" data-live-action-param="loadMore">
                Weitere laden <span class="text-muted">({{ total - items|length }})</span>
            </button>
        </div>
    {% endif %}
</div>
