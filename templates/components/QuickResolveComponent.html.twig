<div {{ attributes }} class="quick-resolve-container">
    <div data-controller="shortcuts">

        {# ───────── Kopf + Filter ───────── #}
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
            <div>
                <h4 class="mb-0">Schnelle Identifizierung</h4>
                <div class="text-muted small">Klick aufs Bild wählt eine Person aus · Lupe = Großansicht</div>
            </div>
            <div class="d-flex align-items-center flex-wrap gap-2">
                {% for opt in [{v: 'new', l: 'Neu'}, {v: 'wasted', l: 'Ausgeblendet'}, {v: 'unknown', l: 'Unbekannt'}] %}
                    <input type="checkbox" class="btn-check" id="qr_status_{{ opt.v }}" value="{{ opt.v }}"
                           data-model="statuses[]" autocomplete="off"
                           {% if opt.v in statuses %}checked{% endif %}>
                    <label class="btn btn-sm btn-outline-secondary" for="qr_status_{{ opt.v }}">{{ opt.l }}</label>
                {% endfor %}
                <span class="badge bg-secondary rounded-pill ms-2">Noch {{ this.remainingCount }} Personen</span>
            </div>
        </div>

        {% set personsList = this.persons %}

        {% if personsList|length > 0 %}
            <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                <button type="button" class="btn btn-sm btn-outline-primary"
                        data-action="live#action" data-live-action-param="selectAll" data-shortcut="a">
                    Alle wählen <kbd>A</kbd>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-action="live#action" data-live-action-param="clearSelection" data-shortcut="escape">
                    Auswahl aufheben <kbd>Esc</kbd>
                </button>
                <span class="text-muted small ms-auto">
                    <strong>{{ selectedPersonIds|length }}</strong> ausgewählt
                </span>
            </div>
        {% endif %}

        {# ───────── Raster ───────── #}
        <div class="row row-cols-2 row-cols-md-3 row-cols-xl-5 g-3 mb-4">
            {% for person in personsList %}
                {% set displayFace = person.profileFace ?: (person.videoFaces|first) %}
                {% set isSelected = person.id in selectedPersonIds %}
                {% set key = loop.index < 10 ? loop.index : (loop.index == 10 ? '0' : '') %}

                {# KI-Vorschlag (Detection) suchen #}
                {% set detectedFace = null %}
                {% for face in person.videoFaces %}
                    {% if face.detection %}
                        {% set detectedFace = face %}
                    {% endif %}
                {% endfor %}

                <div class="col">
                    <div class="card h-100 shadow-sm person-card {{ isSelected ? 'selected' : '' }}">
                        <div class="position-relative">
                            <label for="qr-sel-{{ person.id }}" class="d-block m-0" style="cursor: pointer;">
                                {% if displayFace %}
                                    {% include '_partials/face_zoom.html.twig' with {
                                        face: displayFace,
                                        canvasSize: 360,
                                        padding: 2.6,
                                        srcWidth: 1200,
                                        srcHeight: 900
                                    } only %}
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-center bg-light text-muted" style="aspect-ratio: 1 / 1;">
                                        <i class="fas fa-user-slash fa-2x"></i>
                                    </div>
                                {% endif %}
                            </label>

                            <input id="qr-sel-{{ person.id }}"
                                   class="form-check-input position-absolute top-0 end-0 m-2 shadow-sm border-primary"
                                   style="width: 1.5rem; height: 1.5rem; z-index: 5;"
                                   type="checkbox"
                                   value="{{ person.id }}"
                                   data-model="selectedPersonIds[]"
                                   {% if isSelected %}checked{% endif %}
                                    {% if key != '' %}data-shortcut="{{ key }}"{% endif %}>

                            {% if key != '' %}
                                <span class="position-absolute top-0 start-0 m-2 badge bg-dark opacity-75" style="z-index: 5;">{{ key }}</span>
                            {% endif %}

                            {% if displayFace %}
                                <button type="button"
                                        class="btn btn-sm btn-dark position-absolute bottom-0 end-0 m-2 opacity-75"
                                        style="z-index: 5;"
                                        title="Großansicht"
                                        data-bs-toggle="modal"
                                        data-bs-target="#imageModal"
                                        data-bs-img="{{ imgproxy_url(displayFace.faceImage, 800, 600, 'fit') }}"
                                        data-bs-box="{{ displayFace.boundingBoxStyles }}"
                                        data-bs-caption="Sichtung in {{ displayFace.video.title ?? '' }}">
                                    <i class="fas fa-search-plus"></i>
                                </button>
                            {% endif %}
                        </div>

                        <div class="card-body p-2 text-center">
                            {% if detectedFace %}
                                <button type="button"
                                        class="btn btn-sm btn-success w-100 py-1 mb-2"
                                        data-action="live#action"
                                        data-live-action-param="assignToDetectedPerson"
                                        data-live-person-id-param="{{ person.id }}"
                                        data-live-detected-person-id-param="{{ detectedFace.detection.id }}"
                                        title="Ähnlichkeit erkannt: {{ detectedFace.matchSimilarity|round(1) }}%">
                                    <i class="fas fa-check-circle me-1"></i> Ist das {{ detectedFace.detection.name }}?
                                </button>
                            {% endif %}

                            <div class="d-flex justify-content-between align-items-center small">
                                <span class="fw-bold text-dark">{{ person.videoFaces|length }} Sichtungen</span>
                                <a href="{{ path('app_identity_resolve', {currentPersonId: person.id, fromQuickResolve: 1}) }}"
                                   class="text-decoration-none" title="Einzeln identifizieren">
                                    Öffnen <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                            <div class="progress mt-1" style="height: 4px;" title="{{ person.showCount }} von 10 Anzeigen">
                                <div class="progress-bar bg-info" role="progressbar" style="width: {{ person.showCount * 10 }}%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center py-5 w-100">
                        <i class="fas fa-search fa-3x mb-3 d-block"></i>
                        <h5>Keine Personen gefunden</h5>
                        <p class="mb-0">Versuche andere Status-Filter oder lade neue Videos hoch.</p>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# ───────── Aktionen ───────── #}
        {% if personsList|length > 0 %}
            <div class="text-center mt-4 pb-5">
                {% if selectedPersonIds|length > 0 %}
                    <div class="d-flex flex-column flex-md-row justify-content-center gap-3 mb-4">
                        <a href="{{ path('app_identity_resolve', {currentPersonId: selectedPersonIds|first, mergeIds: selectedPersonIds|slice(1)|join(','), fromQuickResolve: 1}) }}"
                           class="btn btn-success btn-lg rounded-pill px-5 shadow"
                           data-shortcut="enter m">
                            <i class="fas fa-object-group me-2"></i>{{ selectedPersonIds|length }} zusammenführen & identifizieren <kbd class="ms-2">Enter</kbd>
                        </a>
                        <button type="button" class="btn btn-outline-danger btn-lg rounded-pill px-5"
                                data-action="live#action" data-live-action-param="markSelectedUnknown" data-shortcut="u">
                            <i class="fas fa-user-slash me-2"></i>Auswahl unbekannt <kbd class="ms-2">U</kbd>
                        </button>
                    </div>
                {% endif %}

                <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
                    <button type="button" class="btn btn-outline-danger rounded-pill px-4"
                            data-action="live#action" data-live-action-param="markAllUnknown"
                            data-live-confirm="Alle sichtbaren Personen als unbekannt markieren?">
                        <i class="fas fa-user-slash me-2"></i>Alle als unbekannt markieren
                    </button>
                    <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow"
                            data-action="live#action" data-live-action-param="nextBatch" data-shortcut="n arrowright">
                        <i class="fas fa-forward me-2"></i>Nächste {{ personsList|length }} laden <kbd class="ms-2">N</kbd>
                    </button>
                </div>
                <p class="text-muted small mt-3 mb-0">
                    Nicht ausgewählte Personen zählen beim Weiterklicken als "gesehen". Nach 10-maligem Anzeigen werden sie automatisch als unbekannt markiert.
                </p>
            </div>
        {% endif %}
    </div>

    <style>
        .quick-resolve-container .person-card {
            border: 3px solid transparent;
            transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
        }
        .quick-resolve-container .person-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        }
        .quick-resolve-container .person-card.selected {
            border-color: var(--bs-primary);
        }
    </style>
</div>