<div {{ attributes }} {% if this.isProcessing %}data-poll="delay(2000)|$render"{% endif %}>
    {% set progress = this.progress %}

    <div class="list-group list-group-flush">
        {% for step in progress.steps %}
            {% set state = step.state %}
            <div class="list-group-item px-4 py-3 d-flex align-items-center {% if state == 'active' %}bg-primary bg-opacity-10{% endif %}">
                <div class="me-3 flex-shrink-0 d-flex align-items-center justify-content-center rounded-circle
                    {% if state == 'done' %}bg-success text-white
                    {% elseif state == 'active' %}bg-primary text-white
                    {% elseif state == 'error' %}bg-danger text-white
                    {% else %}bg-light text-muted{% endif %}"
                     style="width: 40px; height: 40px;">
                    {% if state == 'done' %}
                        <i class="fas fa-check"></i>
                    {% elseif state == 'error' %}
                        <i class="fas fa-exclamation-triangle"></i>
                    {% elseif state == 'active' %}
                        <i class="fas fa-{{ step.step.icon }} fa-beat-fade"></i>
                    {% else %}
                        <i class="fas fa-{{ step.step.icon }}"></i>
                    {% endif %}
                </div>
                <div class="flex-grow-1 min-w-0">
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <h6 class="fw-bold mb-0 {% if state == 'pending' %}text-muted{% endif %}">{{ step.step.label }}</h6>
                        {% if state == 'active' %}
                            <small class="fw-bold text-primary">{{ step.percent }}%</small>
                        {% endif %}
                    </div>
                    <small class="text-muted">{{ step.detail }}{% if state == 'active' and not step.counted %} (geschätzt){% endif %}</small>
                    {% if state == 'active' %}
                        <div class="progress mt-2" style="height: 4px;">
                            <div class="progress-bar {% if not step.counted %}progress-bar-striped progress-bar-animated{% endif %}" style="width: {{ step.percent }}%;"></div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
