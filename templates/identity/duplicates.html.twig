{% extends 'base.html.twig' %}

{% block title %}Doppelte Personen - Momentary{% endblock %}

{% macro face(person, face) %}
    <a href="{{ path('person_detail', {id: person.id}) }}" class="text-decoration-none text-body text-center d-block">
        <div class="ratio ratio-1x1 rounded-circle overflow-hidden bg-body-secondary mx-auto duplicate-face">
            {% if face and face.faceImage %}
                <img src="{{ face_crop_url(face.faceImage.relativePath, face.boundingBox, 240) }}" alt="{{ person.displayName }}" class="object-fit-cover">
            {% else %}
                <span class="d-flex align-items-center justify-content-center text-muted"><i class="fas fa-user fa-2x"></i></span>
            {% endif %}
        </div>
        <div class="fw-semibold mt-2 text-truncate">{{ person.displayName }}</div>
        <div class="small text-muted">{{ person.videoFaces|length }} Gesicht{{ person.videoFaces|length == 1 ? '' : 'er' }}</div>
    </a>
{% endmacro %}

{% block body %}
{% import _self as ui %}
<div class="container pb-5">
    <h1 class="fw-bold mb-1">Doppelte Personen</h1>
    <p class="text-muted mb-4">
        Diese Personen sehen sich laut Gesichtserkennung ähnlich und kommen nie zusammen in einem Bild vor: vermutlich derselbe Mensch.
        Beim Zusammenführen bleibt die linke Person erhalten (die benannte bzw. die mit mehr Gesichtern).
    </p>

    {% if suggestions is empty %}
        <div class="text-center text-muted py-5">
            <i class="fas fa-people-arrows fa-3x mb-3 opacity-50"></i>
            <p class="mb-0">Keine vermutlich doppelten Personen.</p>
        </div>
    {% endif %}

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        {% for s in suggestions %}
            {% set action = path('app_identity_duplicates_decide', {keep: s.keep.id, merge: s.merge.id}) %}
            {% set token = csrf_token('person-pair-' ~ s.keep.id ~ '-' ~ s.merge.id) %}
            <div class="col">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2">
                            <div class="flex-fill min-w-0">{{ ui.face(s.keep, s.keepFace) }}</div>
                            <div class="text-center flex-shrink-0">
                                <span class="badge text-bg-{{ s.confidenceColor }}">{{ s.similarity|round }} %</span>
                                <div class="small text-muted mt-1">{{ s.confidence }}</div>
                                <i class="fas fa-arrow-left text-muted mt-1"></i>
                            </div>
                            <div class="flex-fill min-w-0">{{ ui.face(s.merge, s.mergeFace) }}</div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex flex-wrap gap-2 justify-content-center pb-3">
                        <form method="post" action="{{ action }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <button class="btn btn-sm btn-success" name="decision" value="same"><i class="fas fa-link me-1"></i>Gleiche Person</button>
                        </form>
                        <form method="post" action="{{ action }}">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <button class="btn btn-sm btn-outline-secondary" name="decision" value="different"><i class="fas fa-not-equal me-1"></i>Verschiedene Personen</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
<style>
    .duplicate-face { max-width: 120px; }
</style>
{% endblock %}
