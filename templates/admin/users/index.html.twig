{% extends 'base.html.twig' %}
{% block title %}Benutzer - Momentary{% endblock %}

{% macro copy(value, label) %}
    <div class="input-group input-group-sm">
        <input type="text" class="form-control font-monospace" value="{{ value }}" readonly aria-label="{{ label }}" onclick="this.select()">
        <button type="button" class="btn btn-outline-secondary" title="Kopieren" data-copy="{{ value }}"><i class="fas fa-copy"></i></button>
    </div>
{% endmacro %}

{% block body %}
{% import _self as ui %}
<div class="container pb-5">
    <div class="text-uppercase small fw-semibold text-muted mb-1">Verwalten</div>
    <h1 class="h3 mb-1">Benutzer</h1>
    <p class="text-muted mb-4" style="max-width: 52rem;">
        <strong>Familie</strong> sieht öffentliche Medien und die ihrer <a href="{{ path('app_admin_pools') }}">Pools</a> – auf dem
        Tablet am besten über den Hub. <strong>Bearbeiter</strong> pflegen das Archiv (hochladen, Personen benennen).
        <strong>Admins</strong> sehen und dürfen alles.
    </p>

    {% if created %}
        <div class="card border-0 shadow-sm mb-4 border-start border-success border-4">
            <div class="card-body">
                <h2 class="h6 fw-bold text-success"><i class="fas fa-key me-2"></i>Zugangsdaten für {{ created.email }} – jetzt notieren</h2>
                <p class="small text-muted">Das Passwort wird nur als Hash gespeichert und lässt sich später nicht wieder anzeigen; bei Bedarf einfach ein neues erzeugen.</p>
                <div class="row g-2 small">
                    <div class="col-md-4"><label class="text-muted mb-1">Anmeldename</label>{{ ui.copy(created.email, 'Anmeldename') }}</div>
                    <div class="col-md-4"><label class="text-muted mb-1">Passwort</label>{{ ui.copy(created.password, 'Passwort') }}</div>
                    <div class="col-md-4"><label class="text-muted mb-1">Anmeldung</label>{{ ui.copy(loginUrl, 'Anmelde-Adresse') }}</div>
                </div>
            </div>
        </div>
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-8">
            {% for user in users %}
                {% set role = 'ROLE_ADMIN' in user.roles ? 'admin' : ('ROLE_EDITOR' in user.roles ? 'editor' : 'family') %}
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <form method="post" action="{{ path('app_admin_users_update', {id: user.id}) }}" class="small">
                            <input type="hidden" name="_token" value="{{ csrf_token('users') }}">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                <span class="fw-semibold">{{ user.email }}{% if user == app.user %} <span class="text-muted fw-normal">(du)</span>{% endif %}</span>
                                <select name="role" class="form-select form-select-sm w-auto" aria-label="Rolle">
                                    {% for key, info in roles %}<option value="{{ key }}" {{ key == role ? 'selected' }}>{{ info.label }}</option>{% endfor %}
                                </select>
                            </div>
                            {% if pools is not empty and role != 'admin' %}
                                <div class="d-flex flex-wrap gap-3 mb-2">
                                    <span class="text-muted">Pools:</span>
                                    {% for pool in pools %}
                                        <div class="form-check form-check-inline m-0">
                                            <input class="form-check-input" type="checkbox" name="pools[]" value="{{ pool.id }}" id="pool-{{ user.id }}-{{ pool.id }}" {{ pool.hasMember(user) ? 'checked' }}>
                                            <label class="form-check-label" for="pool-{{ user.id }}-{{ pool.id }}">{{ pool.name }}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-primary" name="action" value="save">Speichern</button>
                                <button class="btn btn-sm btn-outline-secondary" name="action" value="password" onclick="return confirm('Neues Passwort für {{ user.email|e('js') }} erzeugen? Das alte gilt dann nicht mehr.')">Neues Passwort</button>
                                {% if user != app.user %}
                                    <button class="btn btn-sm btn-outline-danger" name="action" value="delete" onclick="return confirm('Konto {{ user.email|e('js') }} löschen?')" title="Löschen"><i class="fas fa-trash-alt"></i></button>
                                {% endif %}
                            </div>
                        </form>
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold"><i class="fas fa-user-plus me-2 text-primary"></i>Konto anlegen</div>
                <div class="card-body">
                    <form method="post" action="{{ path('app_admin_users_create') }}" class="small">
                        <input type="hidden" name="_token" value="{{ csrf_token('users') }}">
                        <label class="form-label mb-1" for="user-email">E-Mail (Anmeldename)</label>
                        <input type="email" id="user-email" name="email" class="form-control form-control-sm mb-2" required>
                        <label class="form-label mb-1" for="user-role">Rolle</label>
                        <select id="user-role" name="role" class="form-select form-select-sm mb-2">
                            {% for key, info in roles %}<option value="{{ key }}">{{ info.label }}</option>{% endfor %}
                        </select>
                        {% if pools is not empty %}
                            <div class="mb-2">
                                <div class="mb-1">Pools</div>
                                {% for pool in pools %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="pools[]" value="{{ pool.id }}" id="new-pool-{{ pool.id }}">
                                        <label class="form-check-label" for="new-pool-{{ pool.id }}">{{ pool.name }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        <label class="form-label mb-1" for="user-password">Passwort (optional)</label>
                        <input type="text" id="user-password" name="password" class="form-control form-control-sm mb-1" autocomplete="new-password" placeholder="leer = gut lesbares erzeugen">
                        <div class="form-text mb-3">Mindestens 8 Zeichen. Wird nach dem Anlegen einmal angezeigt.</div>
                        <button class="btn btn-sm btn-primary" type="submit">Anlegen</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', () => {
        navigator.clipboard.writeText(button.dataset.copy).then(() => {
            const icon = button.querySelector('i');
            if (icon) { icon.className = 'fas fa-check'; setTimeout(() => { icon.className = 'fas fa-copy'; }, 1500); }
        });
    }));
</script>
{% endblock %}
