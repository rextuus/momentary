{% extends 'base.html.twig' %}
{% block title %}Pools - Momentary{% endblock %}

{% block body %}
<div class="container pb-5">
    <div class="text-uppercase small fw-semibold text-muted mb-1">Verwalten</div>
    <h1 class="h3 mb-1">Pools</h1>
    <p class="text-muted mb-4" style="max-width: 52rem;">
        Ein Pool legt fest, wer was sieht: z. B. „Familie“ mit deiner Mutter und den alten Heimvideos, „Verwandte“ mit einer
        kleineren Auswahl. Medien kommen über <strong>Regeln</strong> (Ereignis, Tag, Zeitraum) in den Pool, auch künftige, oder
        <strong>einzeln</strong> über die Pool-Karte auf jeder Video- und Fotoseite. Mitglieder sehen die Medien ihrer Pools,
        die Personen darin und können danach suchen – sonst nichts (außer öffentlichen Medien).
    </p>

    <div class="row g-4">
        <div class="col-lg-8">
            {% for pool in pools %}
                <a href="{{ path('app_admin_pools_show', {id: pool.id}) }}" class="card border-0 shadow-sm mb-3 text-decoration-none text-body">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div>
                            <div class="fw-semibold"><i class="fas fa-layer-group text-primary me-2"></i>{{ pool.name }}</div>
                            {% if pool.description %}<div class="small text-muted">{{ pool.description }}</div>{% endif %}
                        </div>
                        <div class="small text-muted text-nowrap">
                            <i class="fas fa-user me-1"></i>{{ pool.members|length }}
                            <i class="fas fa-photo-film ms-3 me-1"></i>{{ counts[pool.id] ?? 0 }}
                            <i class="fas fa-filter ms-3 me-1"></i>{{ pool.rules|length }} Regel{{ pool.rules|length == 1 ? '' : 'n' }}
                        </div>
                    </div>
                </a>
            {% else %}
                <div class="text-center text-muted py-5">
                    <i class="fas fa-layer-group fa-3x mb-3 opacity-50"></i>
                    <p class="mb-0">Noch keine Pools. Ohne Pool sehen Familienmitglieder nur öffentliche Medien.</p>
                </div>
            {% endfor %}
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent fw-semibold"><i class="fas fa-plus me-2 text-primary"></i>Neuer Pool</div>
                <div class="card-body">
                    <form method="post" action="{{ path('app_admin_pools_create') }}" class="small">
                        <input type="hidden" name="_token" value="{{ csrf_token('pools') }}">
                        <label class="form-label mb-1" for="pool-name">Name</label>
                        <input type="text" id="pool-name" name="name" class="form-control form-control-sm mb-2" required placeholder="z. B. Familie">
                        <label class="form-label mb-1" for="pool-description">Beschreibung (optional)</label>
                        <textarea id="pool-description" name="description" class="form-control form-control-sm mb-3" rows="2" placeholder="z. B. Mama und Papa: alte Heimvideos"></textarea>
                        <button class="btn btn-sm btn-primary" type="submit">Anlegen</button>
                    </form>
                </div>
            </div>
            <p class="small text-muted mt-3 mb-0">Konten für Familienmitglieder: <a href="{{ path('app_admin_users') }}">Verwalten → Benutzer</a>.</p>
        </div>
    </div>
</div>
{% endblock %}
