{% extends 'base.html.twig' %}

{% block title %}Warteschlange - Momentary{% endblock %}

{% block body %}
    <div class="container pb-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Warteschlange</li>
            </ol>
        </nav>

        <h1 class="fw-bold mb-4">Aktuelle Warteschlange</h1>

        {% if queues is null %}
            <div class="alert alert-secondary shadow-sm">
                Worker-Status unbekannt: RabbitMQ-Management nicht erreichbar.
            </div>
        {% else %}
            <div class="alert {{ isWorkerRunning ? 'alert-success' : 'alert-danger' }} shadow-sm">
                Worker-Status: <strong>{{ isWorkerRunning ? 'Aktiv' : 'Nachrichten bleiben liegen' }}</strong>
                {% if not isWorkerRunning %}
                    <br>Mindestens eine Queue hat wartende Nachrichten, aber keinen Worker. Prüfen:
                    <code>docker compose ps</code>, Logs des genannten Dienstes.
                {% endif %}
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Queue</th><th>Worker</th><th class="text-end">wartend</th><th class="text-end">Worker aktiv</th></tr>
                        </thead>
                        <tbody>
                            {% for queue in queues %}
                                <tr class="{{ queue.stuck ? 'table-danger' : '' }}">
                                    <td><code>{{ queue.name }}</code></td>
                                    <td>{{ queue.worker }}</td>
                                    <td class="text-end">{{ queue.messages }}</td>
                                    <td class="text-end">{{ queue.consumers }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Video</th>
                            <th>Status</th>
                            <th>Erstellt</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for video in videos %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_video_show', {id: video.id}) }}">
                                        {{ video.title ?? 'Unbenanntes Video' }}
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-primary">{{ video.status.value }}</span>
                                </td>
                                <td>{{ video.createdAt|date('d.m.Y H:i') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center py-3">Keine Videos in der Warteschlange.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
