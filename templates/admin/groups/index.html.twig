{% extends 'base.html.twig' %}

{% block title %}Gruppenverwaltung{% endblock %}

{% block body %}
    <h1>Gruppenverwaltung</h1>
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Besitzer</th>
                <th>Mitglieder</th>
                <th>Aktionen</th>
            </tr>
        </thead>
        <tbody>
            {% for group in groups %}
                <tr>
                    <td>{{ group.id }}</td>
                    <td>{{ group.name }}</td>
                    <td>{{ group.owner.email }}</td>
                    <td>{{ group.members|length }}</td>
                    <td>
                        <a href="{{ path('app_admin_groups_members', {'id': group.id}) }}" class="btn btn-sm btn-info">Mitglieder verwalten</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
