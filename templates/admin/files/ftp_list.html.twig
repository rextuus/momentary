{% extends 'base.html.twig' %}

{% block title %}Dateien in {{ dir }}{% endblock %}

{% block body %}
<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_files_ftp') }}">FTP/SFTP</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ dir }}</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="h3 fw-bold mb-4">Dateien in {{ dir }}</h1>
            
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Dateiname</th>
                            <th>Größe</th>
                            <th class="text-end">Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for file in files %}
                            <tr>
                                <td>{{ file.filename }}</td>
                                <td>{{ (file.size / 1024 / 1024)|number_format(2) }} MB</td>
                                <td class="text-end">
                                    <form action="{{ path('admin_files_ftp_move') }}" method="POST" class="d-inline">
                                        <input type="hidden" name="path" value="{{ file.path }}">
                                        <input type="hidden" name="dir" value="{{ dir }}">
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fas fa-arrows-alt me-1"></i> Verschieben
                                        </button>
                                    </form>
                                    {% if '/var/www/html/var/uploads/app_uploads' in dir %}
                                        <form action="{{ path('admin_files_ftp_rename') }}" method="POST" class="d-inline">
                                            <input type="hidden" name="path" value="{{ file.path }}">
                                            <input type="hidden" name="dir" value="{{ dir }}">
                                            <input type="text" name="new_name" placeholder="Neuer Name" required class="form-control form-control-sm d-inline-block" style="width: auto;">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                                <i class="fas fa-edit me-1"></i> Umbenennen
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">Keine Dateien gefunden.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div class="mt-4">
                <a href="{{ path('admin_files_ftp') }}" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fas fa-arrow-left me-1"></i> Zurück zur Übersicht
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
