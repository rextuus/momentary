{% extends 'base.html.twig' %}
{% block title %}Vorschlag übernehmen - Momentary{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block body %}
<div class="container pb-5" style="max-width: 960px;">
    <nav aria-label="breadcrumb"><ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="{{ path('app_event_index', {gap: gap}) }}">Ereignisse</a></li>
        <li class="breadcrumb-item active">Vorschlag übernehmen</li>
    </ol></nav>
    <h1 class="fw-bold mb-3">Vorschlag als Ereignis übernehmen</h1>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
                {{ form_row(form.title, {help: 'Vorschlag aus den Inhalten der Medien, gern anpassen.'}) }}
                <div class="row g-3">
                    <div class="col-sm-6">{{ form_row(form.startDate) }}</div>
                    <div class="col-sm-6">{{ form_row(form.endDate) }}</div>
                </div>
                {{ form_row(form.description) }}
                <button type="submit" class="btn btn-primary"><i class="fas fa-check me-1"></i> Ereignis anlegen</button>
            {{ form_end(form) }}
        </div>
    </div>

    <h2 class="h6 text-uppercase text-muted fw-semibold">{{ suggestion.media|length }} Medien</h2>
    <div class="row row-cols-3 row-cols-md-5 row-cols-lg-6 g-2">
        {% for medium in suggestion.media %}
            <div class="col">
                <a href="{{ medium_path(medium) }}" class="d-block position-relative rounded overflow-hidden bg-body-secondary" title="{{ medium.title }}">
                    <div class="ratio ratio-1x1">
                        {% if medium.previewFile %}<img src="{{ imgproxy_url(medium.previewFile, 240, 240) }}" alt="" class="object-fit-cover" loading="lazy">{% endif %}
                    </div>
                    <span class="position-absolute top-0 start-0 m-1 badge rounded-pill text-bg-dark bg-opacity-75"><i class="fas {{ medium_icon(medium) }}"></i> {{ medium.date|date('d.m. H:i') }}</span>
                </a>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
