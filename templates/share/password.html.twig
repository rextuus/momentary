{% extends 'share/base.html.twig' %}
{% block title %}Passwort{% endblock %}
{% block body %}
    <div class="row justify-content-center py-4">
        <div class="col-sm-8 col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h5 fw-bold mb-1"><i class="fas fa-lock text-primary me-2"></i>Geschützter Link</h1>
                    <p class="small text-muted">Zum Ansehen bitte das Passwort eingeben, das du mit dem Link bekommen hast.</p>
                    {% if error %}<div class="alert alert-danger py-2 small">{{ error }}</div>{% endif %}
                    <form method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('share-unlock') }}">
                        <input type="password" name="password" class="form-control mb-3" placeholder="Passwort" aria-label="Passwort" autofocus required autocomplete="off">
                        <button class="btn btn-primary w-100" type="submit">Ansehen</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
