{# Öffentliche Seiten eines Share-Links: ohne Navigation, ohne Hinweise auf den Rest des Archivs #}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {# Der Token steht in der Adresse: nicht an Bild-Server oder andere Seiten weitergeben #}
    <meta name="referrer" content="no-referrer">
    <title>{% block title %}Geteilt{% endblock %} · Momentary</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎬</text></svg>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    {{ importmap('app') }}
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8fafc; color: #1e293b; }
        .share-header { background: #fff; border-bottom: 1px solid #e2e8f0; }
        .share-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 6px; }
        .share-tile { position: relative; display: block; aspect-ratio: 1; overflow: hidden; border-radius: 8px; background: #e2e8f0; }
        .share-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s ease; }
        .share-tile:hover img { transform: scale(1.04); }
        .share-badge { position: absolute; left: 6px; top: 6px; font-size: 0.75rem; color: #fff; background: rgba(0, 0, 0, 0.55); border-radius: 999px; padding: 0 0.45rem; }
        .share-stage { background: #000; border-radius: 12px; overflow: hidden; display: flex; justify-content: center; }
        .share-stage img, .share-stage video { max-width: 100%; max-height: 80vh; display: block; }
        @media (max-width: 575.98px) { .share-grid { grid-template-columns: repeat(3, 1fr); gap: 3px; } }
    </style>
</head>
<body>
    <header class="share-header mb-4">
        <div class="container py-3 d-flex align-items-center justify-content-between gap-3">
            <span class="fw-bold text-primary"><i class="fas fa-film me-2"></i>Momentary</span>
            <span class="small text-muted"><i class="fas fa-link me-1"></i>Geteilter Link</span>
        </div>
    </header>
    <main class="container pb-5">
        {% block body %}{% endblock %}
    </main>
</body>
</html>
