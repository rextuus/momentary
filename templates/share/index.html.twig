{% extends 'base.html.twig' %}
{% block title %}Freigaben - Momentary{% endblock %}

{% block body %}
<div class="container pb-5">
    <h1 class="fw-bold mb-1">Freigaben</h1>
    <p class="text-muted mb-4">
        Links, mit denen andere ohne Anmeldung ein Ereignis oder ein einzelnes Video bzw. Foto ansehen können.
        Neue Links gibt es auf der Ereignis-, Video- oder Fotoseite unter „Teilen“.{% if is_granted('ROLE_ADMIN') %} Als Admin siehst du die Links aller Benutzer.{% endif %}
    </p>

    {% if links is empty %}
        <div class="text-center text-muted py-5">
            <i class="fas fa-share-nodes fa-3x mb-3 opacity-50"></i>
            <p class="mb-0">Noch nichts geteilt.</p>
        </div>
    {% else %}
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0 small">
                    <thead><tr><th>Geteilt</th><th>Notiz</th><th>Status</th><th>Gültig bis</th><th class="text-end">Aufrufe</th>{% if is_granted('ROLE_ADMIN') %}<th>Von</th>{% endif %}<th></th></tr></thead>
                    <tbody>
                    {% for link in links %}
                        <tr class="{{ link.active ? '' : 'text-muted' }}">
                            <td>
                                {% if link.event %}
                                    <a href="{{ path('app_event_show', {id: link.event.id}) }}"><i class="fas fa-calendar-days me-1"></i>{{ link.event.title }}</a>
                                {% elseif link.medium %}
                                    <a href="{{ medium_path(link.medium) }}"><i class="fas {{ medium_icon(link.medium) }} me-1"></i>{{ link.medium.title }}</a>
                                {% endif %}
                            </td>
                            <td>{{ link.label }}{% if link.hasPassword %} <i class="fas fa-lock ms-1" title="mit Passwort"></i>{% endif %}{% if link.allowDownload %} <i class="fas fa-download ms-1" title="Herunterladen erlaubt"></i>{% endif %}</td>
                            <td><span class="badge rounded-pill {{ link.active ? 'text-bg-success' : 'text-bg-light border' }}">{{ link.statusLabel }}</span></td>
                            <td class="text-nowrap">{{ link.expiresAt ? link.expiresAt|date('d.m.Y H:i') : 'unbegrenzt' }}</td>
                            <td class="text-end">{{ link.viewCount }}</td>
                            {% if is_granted('ROLE_ADMIN') %}<td>{{ link.createdBy.email }}</td>{% endif %}
                            <td class="text-end text-nowrap">
                                {% if link.active %}
                                    {% set url = url('app_share_show', {token: link.token}) %}
                                    <button type="button" class="btn btn-sm btn-light border py-0" title="Link kopieren"
                                            onclick="navigator.clipboard.writeText('{{ url|e('js') }}').then(() => { this.innerHTML = '<i class=&quot;fas fa-check&quot;></i>'; })"><i class="fas fa-copy"></i></button>
                                    <form method="post" action="{{ path('app_share_revoke', {id: link.id}) }}" class="d-inline" onsubmit="return confirm('Link zurückziehen?')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('share-revoke') }}">
                                        <button class="btn btn-sm btn-outline-danger py-0" title="Zurückziehen"><i class="fas fa-ban"></i></button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
