{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^4.3",
        "aws/aws-sdk-php": "^3.381.2",
        "doctrine/dbal": "^4.4.3",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.6.5",
        "google-gemini-php/client": "^2.7",
        "google/cloud-vision": "^2.2.1",
        "league/flysystem-bundle": "^3.7",
        "league/oauth2-server-bundle": "^1.2",
        "lexik/jwt-authentication-bundle": "^3.2",
        "meilisearch/meilisearch-php": "^1.17",
        "onliner/imgproxy-php": "^0.2.6",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.2",
        "ramsey/uuid": "^4.9.4",
        "sentry/sentry": "^4.34",
        "sentry/sentry-symfony": "^5.11",
        "symfony/amqp-messenger": "8.1.*",
        "symfony/apache-pack": "^1.0.1",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.10",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/mime": "8.1.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/notifier": "8.1.*",
        "symfony/process": "8.1.*",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-autocomplete": "^2.35",
        "symfony/ux-live-component": "^2.35",
        "symfony/ux-twig-component": "^2.35",
        "symfony/validator": "8.1.*",
        "symfony/web-link": "8.1.*",
        "symfony/workflow": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/sass-bundle": "^0.10.0",
        "twig/extra-bundle": "^2.12|^3.24",
        "twig/twig": "^2.12|^3.25"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true,
            "carthage-software/mago": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:slow": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose exec messenger-worker vendor/bin/phpunit --group slow"
        ],
        "cs": [
            "mago format --check",
            "mago lint"
        ],
        "cs:fix": [
            "mago lint --fix --potentially-unsafe",
            "mago format"
        ],
        "phpstan": [
            "@php bin/console cache:warmup --env=test --quiet",
            "phpstan analyse --memory-limit=2G"
        ],
        "phpstan:baseline": [
            "@php bin/console cache:warmup --env=test --quiet",
            "phpstan analyse --memory-limit=2G --generate-baseline phpstan-baseline.neon"
        ],
        "qa": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "carthage-software/mago": "^1.57",
        "dama/doctrine-test-bundle": "^8.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/phpunit-bridge": "^8.1",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "zenstruck/foundry": "^2.14"
    },
    "scripts-descriptions": {
        "cs": "Code-Stil und Lint prüfen (Mago)",
        "cs:fix": "Code-Stil und Lint-Befunde automatisch beheben (Mago)",
        "phpstan": "Statische Analyse (PHPStan, Level 8)",
        "phpstan:baseline": "PHPStan-Baseline neu erzeugen",
        "qa": "Alles: Stil, Analyse, Tests",
        "test": "Testsuite ohne langsame Tests",
        "test:unit": "Nur Unit-Tests",
        "test:slow": "Echte ffmpeg/PySceneDetect-Pipeline im Worker-Container"
    }
}
