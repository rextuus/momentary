# Momentary – Produktionswerte. Vorlage ohne echte Werte, nie echte Werte hier eintragen.
#
# Zwei Wege, die Werte an compose.prod.yaml zu geben (Ergebnis ist jedes Mal .env.prod.local im Stack-Ordner):
#  - Komodo (Standard): Werte im Stack unter „Environment“ (deploy/komodo/momentary.toml). Mit [SECRET] markierte
#    Werte als Komodo-Variable mit Häkchen „Secret“ anlegen (Settings → Variables, Name hinter „Komodo:“). Komodo
#    schreibt .env.prod.local bei jedem Deploy neu – die Datei auf dem Server also nicht von Hand ändern.
#  - Von Hand (Fallback): `make prod-secrets` kopiert diese Datei nach .env.prod.local und füllt leere Secrets
#    mit Zufallswerten; danach `make prod-up`.
# .env.prod.local nie ins Repository. Die Secrets sicher aufbewahren (Passwortmanager): ohne sie lassen sich
# Sicherungen nicht einspielen. Laufen Daten weiter, die BISHERIGEN Werte übernehmen, nie neu würfeln.

# --- Adresse ---------------------------------------------------------------------------------------------
# Öffentliche Adresse mit https:// (steckt in signierten Video-Links; Bilder laufen über <Adresse>/imgproxy).
# Komodo: fest in deploy/komodo/momentary.toml.
APP_PUBLIC_URL=https://momentary.example.de
# Leer = <APP_PUBLIC_URL>/imgproxy (Normalfall)
IMGPROXY_PUBLIC_HOST=

# --- Secrets ---------------------------------------------------------------------------------------------
# [SECRET] Symfony-Schlüssel (Sitzungen, signierte Links), 64 Hex-Zeichen. Komodo: MOMENTARY_APP_SECRET
APP_SECRET=
# [SECRET] Passwort des Datenbank-Benutzers. Gilt nur beim allerersten Start; danach muss es zum Volume passen.
# Komodo: MOMENTARY_MYSQL_PASSWORD
MYSQL_PASSWORD=
# [SECRET] Root-Passwort der Datenbank (auch für die Sicherungen). Wie oben. Komodo: MOMENTARY_MYSQL_ROOT_PASSWORD
MYSQL_ROOT_PASSWORD=
# [SECRET] Passwort für RabbitMQ (gilt nur beim ersten Start des Volumes). Komodo: MOMENTARY_RABBITMQ_PASS
RABBITMQ_PASS=
# [SECRET] Meilisearch-Hauptschlüssel, mindestens 16 Zeichen. Komodo: MOMENTARY_MEILI_MASTER_KEY
MEILI_MASTER_KEY=
# [SECRET] imgproxy-Signatur (Hex). Komodo: MOMENTARY_IMGPROXY_KEY, MOMENTARY_IMGPROXY_SALT
IMGPROXY_KEY=
IMGPROXY_SALT=
# [SECRET] Verschlüsselung der OAuth2-Tokens (openssl rand -base64 32). Komodo: MOMENTARY_OAUTH_ENCRYPTION_KEY
OAUTH_ENCRYPTION_KEY=
# [SECRET] Mailversand (kann Zugangsdaten enthalten). Momentary verschickt derzeit nichts.
# Komodo: MOMENTARY_MAILER_DSN (anlegen mit dem Wert null://null)
MAILER_DSN=null://null
# Passphrasen der Schlüsselpaare in KEYS_DIR – leer, die Schlüssel werden ohne Passphrase erzeugt. Nicht in Komodo.
OAUTH_PASSPHRASE=
JWT_PASSPHRASE=

# --- Externe Dienste (kosten Geld bzw. optional) ---------------------------------------------------------
# [SECRET] Gesichtserkennung (AWS Rekognition). Komodo: MOMENTARY_AWS_ACCESS_KEY, MOMENTARY_AWS_SECRET_KEY
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-central-1
# [SECRET] Tags, Titel, Kapitel (Gemini). Komodo: MOMENTARY_GEMINI_API_KEY
GEMINI_API_KEY=
# [SECRET] Jellyfin → Dashboard → API-Schlüssel, erst nach dem ersten Start anlegen. Komodo:
# MOMENTARY_JELLYFIN_API_KEY (Zeile dann im Environment der momentary.toml ergänzen)
JELLYFIN_API_KEY=
# Fehlerberichte (optional, derzeit nicht in Komodo)
SENTRY_DSN=

# --- Datenbank und Warteschlange (fest, nicht ändern: gehört zu den Volumes) -------------------------------
MYSQL_DATABASE=momentary_prod
MYSQL_USER=momentary
RABBITMQ_USER=momentary

# --- Verhalten -------------------------------------------------------------------------------------------
# Ortsnamen über OpenStreetMap Nominatim (0 = aus)
GEOCODING_ENABLED=1
# storage/imports alle 5 Minuten automatisch übernehmen (0 = nur über Verwalten → Import-Ordner)
IMPORT_FOLDER_WATCH=0

# --- Gesichtserkennung (face-service, InsightFace) ------------------------------------------------------------
# Detektionsgröße in Pixeln (Vielfaches von 32), Mindest-Score einer Detektion, ONNX-Threads. Komodo: momentary.toml.
FACE_DET_SIZE=640
FACE_MIN_DET_SCORE=0.5
FACE_INTRA_OP_THREADS=2
FACE_INTER_OP_THREADS=1
# Wie lange app/Worker auf eine Antwort warten (Sekunden), einschließlich Warten auf eine laufende Anfrage
FACE_SERVICE_TIMEOUT=60
# Anbieter: insightface (face-service) oder rekognition (AWS, kostet, braucht MOMENTARY_AWS_*)
FACE_RECOGNITION_PROVIDER=insightface
# Vorfilter mit kleiner Detektionsgröße (z. B. 320) vor der eigentlichen Analyse; 0 = aus
FACE_PREFILTER_DET_SIZE=0
# Referenzgesichter je Person beim Abgleich neuer Gesichter
FACE_MATCH_REFERENCES_PER_PERSON=20

# --- Eingang: Caddy auf dem VPS → WireGuard → hierher -----------------------------------------------------
# Der einzige Host-Port des Stacks (app). Auf abyss: 8194. Komodo: fest in momentary.toml.
HTTP_PORT=8194
# Nur auf dieser Adresse lauschen – die WireGuard-IP von abyss (10.0.0.2). Komodo: fest in momentary.toml.
HTTP_BIND=10.0.0.2
# Von wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS-Caddys. Komodo: fest in momentary.toml.
REVERSE_PROXY_IPS=10.0.0.1

# --- Daten auf dem Host (außerhalb des Stack-Ordners; müssen existieren, documentation/deployment.md) -------
# Medien (Videos, Fotos, Gesichter, Import-Ordner, Jellyfin-Uploads)
STORAGE_DIR=/srv/momentary/storage
# Schlüsselpaare für die API: oauth2/private.key + public.key, jwt/private.pem + public.pem
KEYS_DIR=/srv/momentary/keys
# Datenbank-Dumps (Dienst backup)
BACKUP_DIR=/srv/momentary/backups
# So viele Dumps je Anlass (daily, pre-deploy, manuell) bleiben liegen; täglich 14 = zwei Wochen.
BACKUP_KEEP=14

# --- Nur für Probeläufe ----------------------------------------------------------------------------------
# Präfix der Volume- und Netznamen (Standard momentary). Auf dem Server NIE setzen. Auf dem Entwicklungsrechner
# für Probeläufe PFLICHT (z. B. momentaryprobe), weil die Entwicklungsumgebung ebenfalls momentary_* heißt.
#VOLUME_PREFIX=momentaryprobe
