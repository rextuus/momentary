# Momentary – Produktion (compose.prod.yaml). Vorlage für .env.prod.local; die legt `make prod-secrets` an
# (siehe documentation/deployment.md). .env.prod.local nie ins Repository.

###> Adressen und Ports ###
# Öffentliche Adresse des Backends (HTTPS macht der Caddy auf dem VPS). Steckt in signierten Video-Links.
APP_PUBLIC_URL=https://admin.momentary.wh-company.com
# Bilder laden Browser über das Backend: <APP_PUBLIC_URL>/imgproxy (leer = genau das)
IMGPROXY_PUBLIC_HOST=
# Backend (Weboberfläche, API, Bilder) – ein HTTP-Port, den der VPS über WireGuard erreicht
HTTP_PORT=8088
# Nur auf dieser Adresse lauschen: am besten die WireGuard-IP dieses Rechners (10.0.0.2); 0.0.0.0 = überall
HTTP_BIND=0.0.0.0
# Von wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS (10.0.0.1)
REVERSE_PROXY_IPS=PRIVATE_SUBNETS
# Jellyfin (media.momentary…, vom Hub genutzt)
JELLYFIN_PORT=8096
JELLYFIN_BIND=0.0.0.0
# SFTP-Upload in den Import-Ordner (nur im Heimnetz gedacht)
SFTP_PORT=2222
SFTP_BIND=0.0.0.0
###< Adressen und Ports ###

###> Secrets (make prod-secrets füllt leere Werte zufällig) ###
APP_SECRET=
MYSQL_DATABASE=momentary_prod
MYSQL_USER=momentary
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
RABBITMQ_USER=momentary
RABBITMQ_PASS=
MEILI_MASTER_KEY=
IMGPROXY_KEY=
IMGPROXY_SALT=
OAUTH_ENCRYPTION_KEY=
OAUTH_PASSPHRASE=
JWT_PASSPHRASE=
SFTP_PASSWORD=
###< Secrets ###

###> Externe Dienste ###
# Jellyfin: API-Schlüssel aus Jellyfin → Dashboard → API-Schlüssel (nach dem ersten Start anlegen)
JELLYFIN_API_KEY=
# Gesichtserkennung (kostet Geld)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-central-1
# Tags, Titel, Kapitel (kostet Geld)
GEMINI_API_KEY=
# Fehlerberichte (optional)
SENTRY_DSN=
###< Externe Dienste ###

###> Verhalten ###
# Ortsnamen über OpenStreetMap Nominatim (0 = aus)
GEOCODING_ENABLED=1
# storage/imports alle 5 Minuten automatisch übernehmen (0 = nur über Verwalten → Import-Ordner)
IMPORT_FOLDER_WATCH=0
###< Verhalten ###
