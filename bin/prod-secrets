#!/usr/bin/env bash
# Legt .env.prod.local aus .env.prod.dist an (siehe documentation/deployment.md). Überschreibt nie eine vorhandene Datei.
#
#   bin/prod-secrets [ZIEL] [SCHLÜSSELORDNER]
#
# Leere Secrets bekommen Zufallswerte. Außerdem: Schlüsselpaare für OAuth2 (API-Clients) und JWT im Schlüsselordner
# (Standard /srv/momentary/keys = KEYS_DIR in compose.prod.yaml), falls sie fehlen. Mit Komodo braucht es nur diesen
# zweiten Teil (sudo bin/prod-secrets /dev/null), die Secrets kommen dort aus den Komodo-Variablen.
set -euo pipefail
cd "$(dirname "$0")/.."

target="${1:-.env.prod.local}"
keys="${2:-/srv/momentary/keys}"

if [ "$target" = /dev/null ]; then
    :
elif [ -e "$target" ]; then
    echo "$target gibt es schon – nichts verändert."
else
    umask 077
    random_values=(
        "APP_SECRET:hex32" "MYSQL_PASSWORD:hex16" "MYSQL_ROOT_PASSWORD:hex16" "RABBITMQ_PASS:hex16"
        "MEILI_MASTER_KEY:hex32" "IMGPROXY_KEY:hex32" "IMGPROXY_SALT:hex32" "OAUTH_ENCRYPTION_KEY:base64"
    )
    tmp="$(mktemp "$target.XXXX")"
    cp .env.prod.dist "$tmp"

    for entry in "${random_values[@]}"; do
        key="${entry%%:*}"
        case "${entry#*:}" in
            hex16) value="$(openssl rand -hex 16)" ;;
            hex32) value="$(openssl rand -hex 32)" ;;
            base64) value="$(openssl rand -base64 32 | tr -d '\n')" ;;
        esac
        KEY="$key" VALUE="$value" awk 'BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VALUE"] }
            $0 == k "=" { print k "=" v; next } { print }' "$tmp" > "$tmp.new"
        mv "$tmp.new" "$tmp"
    done

    mv "$tmp" "$target"
    chmod 600 "$target"
    echo "$target angelegt – jetzt Adressen und Schlüssel eintragen (documentation/deployment.md, Schritt 3)."
fi

# Schlüsselpaare für die API (OAuth2) und JWT – ohne Passphrase, nur lesbar für den Besitzer
umask 077
mkdir -p "$keys/oauth2" "$keys/jwt"
if [ ! -f "$keys/oauth2/private.key" ]; then
    openssl genrsa -out "$keys/oauth2/private.key" 2048 2> /dev/null
    openssl rsa -in "$keys/oauth2/private.key" -pubout -out "$keys/oauth2/public.key" 2> /dev/null
    echo "$keys/oauth2/ Schlüsselpaar erzeugt"
fi
if [ ! -f "$keys/jwt/private.pem" ]; then
    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$keys/jwt/private.pem" 2> /dev/null
    openssl pkey -in "$keys/jwt/private.pem" -pubout -out "$keys/jwt/public.pem" 2> /dev/null
    echo "$keys/jwt/ Schlüsselpaar erzeugt"
fi
