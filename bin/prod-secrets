#!/usr/bin/env bash
# Legt .env.prod.local aus .env.prod.dist an (siehe documentation/deployment.md). Überschreibt nie eine vorhandene Datei.
#
#   bin/prod-secrets [ZIEL]
#
# Leere Secrets bekommen Zufallswerte. Außerdem: Schlüsselpaare für OAuth2 (API-Clients) und JWT in config/, falls sie
# fehlen.
set -euo pipefail
cd "$(dirname "$0")/.."

target="${1:-.env.prod.local}"

if [ -e "$target" ]; then
    echo "$target gibt es schon – nichts verändert."
else
    umask 077
    random_values=(
        "APP_SECRET:hex32" "MYSQL_PASSWORD:hex16" "MYSQL_ROOT_PASSWORD:hex16" "RABBITMQ_PASS:hex16"
        "MEILI_MASTER_KEY:hex32" "IMGPROXY_KEY:hex32" "IMGPROXY_SALT:hex32" "OAUTH_ENCRYPTION_KEY:base64"
        "SFTP_PASSWORD:hex12"
    )
    tmp="$(mktemp "$target.XXXX")"
    cp .env.prod.dist "$tmp"

    for entry in "${random_values[@]}"; do
        key="${entry%%:*}"
        case "${entry#*:}" in
            hex12) value="$(openssl rand -hex 12)" ;;
            hex16) value="$(openssl rand -hex 16)" ;;
            hex32) value="$(openssl rand -hex 32)" ;;
            base64) value="$(openssl rand -base64 32 | tr -d '\n')" ;;
        esac
        KEY="$key" VALUE="$value" awk 'BEGIN { k = ENVIRON["KEY"]; v = ENVIRON["VALUE"] }
            $0 == k "=" { print k "=" v; next } { print }' "$tmp" > "$tmp.new"
        mv "$tmp.new" "$tmp"
    done

    mv "$tmp" "$target"
    chmod 600 "$target"
    echo "$target angelegt – jetzt Adressen und Schlüssel eintragen (documentation/deployment.md, Schritt 3)."
fi

# Schlüsselpaare für die API (OAuth2) und JWT – ohne Passphrase, nur lesbar für den Besitzer
mkdir -p config/oauth2 config/jwt
if [ ! -f config/oauth2/private.key ]; then
    openssl genrsa -out config/oauth2/private.key 2048 2> /dev/null
    openssl rsa -in config/oauth2/private.key -pubout -out config/oauth2/public.key 2> /dev/null
    chmod 600 config/oauth2/private.key
    echo "config/oauth2/ Schlüsselpaar erzeugt"
fi
if [ ! -f config/jwt/private.pem ]; then
    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out config/jwt/private.pem 2> /dev/null
    openssl pkey -in config/jwt/private.pem -pubout -out config/jwt/public.pem 2> /dev/null
    chmod 600 config/jwt/private.pem
    echo "config/jwt/ Schlüsselpaar erzeugt"
fi
