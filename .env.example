# Vorlage für die lokale Entwicklung: nach .env kopieren und Schlüssel eintragen (.env steht nicht im Git).
# Docker Compose liest .env für compose.yaml, Symfony für die Anwendung. Rechnerspezifisches in .env.local.
# Das Produktions-Image nutzt diese Datei nur als Rückfall; echte Werte kommen aus .env.prod.local
# (siehe documentation/deployment.md).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=
###< symfony/framework-bundle ###

###> Ports (lokale Entwicklung, compose.yaml) ###
APP_HOST_BINDING=0.0.0.0
APP_PORT=8088
IMGPROXY_HOST_BINDING=0.0.0.0
IMGPROXY_PORT=8080
JELLYFIN_HOST_BINDING=0.0.0.0
JELLYFIN_PORT=8096
RABBITMQ_HOST_BINDING=127.0.0.1
SFTP_HOST_BINDING=0.0.0.0
SFTP_PORT=2222
SFTP_PASSWORD=MeinSicheresPasswort123
###< Ports ###

###> Datenbank ###
MYSQL_DATABASE=momentary_dev
MYSQL_USER=app
MYSQL_PASSWORD=secret_dev_pass
MYSQL_ROOT_PASSWORD=secret_root_dev
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@database:3306/${MYSQL_DATABASE}?serverVersion=8.4.11&charset=utf8mb4"
###< Datenbank ###

###> RabbitMQ ###
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672/%2f/messages"
###< RabbitMQ ###

###> Meilisearch ###
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=local_master_key_must_be_32_chars_long!!
MEILI_ENV=development
###< Meilisearch ###

###> imgproxy ###
IMGPROXY_KEY=943f17d3b15f94d936173d120a1b2c3d
IMGPROXY_SALT=5d7b5f2a1b9c3d4e5f6a7b8c9d0e1f2a
# Adresse, unter der Browser die Bilder laden (lokal direkt der imgproxy-Port, live <Backend>/imgproxy)
IMGPROXY_PUBLIC_HOST=http://localhost:8080
###< imgproxy ###

###> Jellyfin ###
JELLYFIN_HOST=http://jellyfin:8096
JELLYFIN_API_KEY=
###< Jellyfin ###

###> AWS Rekognition und Gemini (kosten Geld, nur mit eigenem Schlüssel) ###
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=eu-central-1
GEMINI_API_KEY=
###< AWS Rekognition und Gemini ###

###> Python, Speicher, Verarbeitung ###
PYTHON_BINARY=/usr/bin/python3
STORAGE_ROOT=storage
FRAME_ANALYSIS_FPS=0.2
MIN_SCENE_LENGTH_FOR_REFINEMENT=2.0
REFINED_FRAME_ANALYSIS_FPS=1.0
###< Python, Speicher, Verarbeitung ###

###> Gesichtserkennung (face-service, InsightFace) ###
# Detektionsgröße in Pixeln (Vielfaches von 32), Mindest-Score einer Detektion, ONNX-Threads des Dienstes
FACE_DET_SIZE=640
FACE_MIN_DET_SCORE=0.5
FACE_INTRA_OP_THREADS=2
FACE_INTER_OP_THREADS=1
# Adresse des Dienstes für app und Worker; Timeout in Sekunden (schließt das Warten auf eine laufende Anfrage ein)
FACE_SERVICE_URL=http://face-service:8000
FACE_SERVICE_TIMEOUT=60
# Anbieter: insightface (face-service) oder rekognition (AWS, kostet, braucht AWS_*)
FACE_RECOGNITION_PROVIDER=insightface
# Vorfilter: erst mit dieser kleinen Detektionsgröße prüfen, ob ein Gesicht im Bild ist (z. B. 320); 0 = aus
FACE_PREFILTER_DET_SIZE=0
# Neue Gesichter werden je Person mit höchstens so vielen Referenzgesichtern verglichen
FACE_MATCH_REFERENCES_PER_PERSON=20
###< Gesichtserkennung ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> league/oauth2-server-bundle ###
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/oauth2/private.key
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/oauth2/public.key
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=
###< league/oauth2-server-bundle ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> Ortsnamen (Reverse-Geocoding über OpenStreetMap Nominatim) ###
# Sendet auf ~100 m gerundete Koordinaten an Nominatim; 0 = aus
GEOCODING_ENABLED=1
NOMINATIM_URL=https://nominatim.openstreetmap.org
###< Ortsnamen ###

###> Import-Ordner ###
# storage/imports alle 5 Minuten nach neuen Videos/Fotos durchsuchen und übernehmen (messenger-worker)
IMPORT_FOLDER_WATCH=0
###< Import-Ordner ###

###> Öffentliche Adresse ###
# Unter dieser Adresse erreichen Browser und Fernseher das Backend (für signierte Stream-URLs, z. B.
# http://192.168.178.56:8088 oder https://momentary.example.de). Leer: Adresse der jeweiligen Anfrage; das passt nicht,
# wenn der Hub das Backend intern als http://app:80 anfragt.
APP_PUBLIC_URL=
###< Öffentliche Adresse ###
