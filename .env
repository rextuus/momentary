# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> Ports & Binding Defaults (Lokale Entwicklung) ###
APP_HOST_BINDING=0.0.0.0
APP_PORT=8088

IMGPROXY_HOST_BINDING=0.0.0.0
IMGPROXY_PORT=8080

JELLYFIN_HOST_BINDING=0.0.0.0
JELLYFIN_PORT=8096

RABBITMQ_HOST_BINDING=0.0.0.0
###< Ports & Binding Defaults ###

###> Application Volumes ###
# Lokaler Code-Sync für die Entwicklung
APP_CODE_VOLUME=./:/var/www/html:rw
###< Application Volumes ###

###> Database Configuration ###
MYSQL_DATABASE=momentary_dev
MYSQL_USER=app
MYSQL_PASSWORD=secret_dev_pass
MYSQL_ROOT_PASSWORD=secret_root_dev
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@database:3306/${MYSQL_DATABASE}?serverVersion=8.0.32&charset=utf8mb4"
###< Database Configuration ###

###> RabbitMQ Configuration ###
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MESSENGER_TRANSPORT_DSN="amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@rabbitmq:5672/%2f/messages"
###< RabbitMQ Configuration ###

###> Meilisearch ###
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=local_master_key_must_be_32_chars_long!!
MEILI_ENV=development
###< Meilisearch ###

###> Imgproxy ###
IMGPROXY_KEY=943f17d3b15f94d936173d120a1b2c3d
IMGPROXY_SALT=5d7b5f2a1b9c3d4e5f6a7b8c9d0e1f2a
IMGPROXY_HOST=http://imgproxy:8080
IMGPROXY_PUBLIC_HOST=http://localhost:8080
###< Imgproxy ###

###> External Services & Keys ###
AWS_FACE_MATCH_THRESHOLD=80.0
AWS_MAX_FACES=15
AWS_QUALITY_FILTER=AUTO

JELLYFIN_HOST=http://host.docker.internal:8096
JELLYFIN_API_KEY=dein_jellyfin_api_key

API_KEY=local_dev_secret_token_123
###< External Services & Keys ###