# Test-Umgebung: alle Werte sind Dummies, damit die Tests ohne lokale .env
# (z. B. in CI) und ohne externe Dienste laufen.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"

# Pipeline-Schritte laufen in Tests synchron im selben Prozess
MESSENGER_TRANSPORT_DSN=sync://

# Wegwerf-Schlüssel, werden von tests/bootstrap.php erzeugt
OAUTH_PRIVATE_KEY=%kernel.project_dir%/var/test-oauth2/private.key
OAUTH_PUBLIC_KEY=%kernel.project_dir%/var/test-oauth2/public.key
OAUTH_PASSPHRASE=
OAUTH_ENCRYPTION_KEY=test-encryption-key
JWT_SECRET_KEY=%kernel.project_dir%/var/test-oauth2/private.key
JWT_PUBLIC_KEY=%kernel.project_dir%/var/test-oauth2/public.key
JWT_PASSPHRASE=

# Externe Dienste: werden in Tests gemockt oder nie erreicht
IMGPROXY_KEY=943f17d3b15f94d936173d120a1b2c3d
IMGPROXY_SALT=5d7b5f2a1b9c3d4e5f6a7b8c9d0e1f2a
IMGPROXY_PUBLIC_HOST=http://imgproxy.test
MEILISEARCH_URL=http://localhost:1
MEILI_MASTER_KEY=test
GEMINI_API_KEY=test
AWS_ACCESS_KEY=test
AWS_SECRET_KEY=test
AWS_REGION=eu-central-1
# Gesichtserkennung: siehe phpunit.xml.dist (dort erzwungen, weil Compose die Werte im Container setzt)
FACE_RECOGNITION_PROVIDER=rekognition
FACE_SERVICE_URL=http://face-service.test
JELLYFIN_HOST=http://jellyfin.test
JELLYFIN_API_KEY=test
MAILER_DSN=null://null
SENTRY_DSN=

PYTHON_BINARY=python3
